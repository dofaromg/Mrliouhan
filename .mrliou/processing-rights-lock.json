  "required_capabilities": {
    "access": true,
    "use": true,
    "export": true,
    "migrate": true,
    "recover": true,
    "verify_integrity": true,
    "inspect_processing_history": true,
    "inspect_billing_correspondence": true,
    "request_stop_processing": true,
    "request_deletion_after_verified_recovery": true,
    "revoke_external_integrations": true
