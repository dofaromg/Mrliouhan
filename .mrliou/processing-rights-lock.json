  "consent_and_record_rules": {
    "restriction_requires_record": true,
    "fee_requires_service_period_and_usage_record": true,
    "deletion_requires_scope_and_receipt": true,
    "transfer_requires_explicit_scope": true,
    "publication_requires_explicit_action_and_reversal_path": true,
    "continued_execution_requires_visible_status_and_stop_path": true,
    "silent_ownership_transfer_forbidden": true,
    "silent_continued_billing_forbidden": true,
    "deletion_before_verified_recovery_forbidden": true
